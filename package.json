{
  "name": "duokeys",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/docs-check.mjs",
    "content:build": "tsx content/build/ingest.ts && tsx content/build/ingestChords.ts",
    "content:build:chords": "tsx content/build/ingestChords.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "fast-xml-parser": "^5.11.1",
    "idb": "^8.0.1",
    "next": "^15.5.0",
    "opensheetmusicdisplay": "^2.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tone": "^15.0.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
